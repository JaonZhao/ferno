{
  "compilerOptions": {
    "baseUrl": "",
    "rootDir": "",
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2016",
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "sourceMap": true,
    "declaration": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "include": [
    "packages/*/src", 
    "packages/*/__tests__"
  ]
}